# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the default model. Defaults to claude-opus-5 if unset.
# Cheaper options for a low-stakes assignment run: claude-sonnet-5, claude-haiku-4-5
CLAUDE_MODEL=claude-opus-5
